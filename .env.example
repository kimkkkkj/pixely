# =====================================================================
# Pixely 환경변수 예시 — 복사해서 .env 로 사용하세요 (Copy-Item .env.example .env)
# 백엔드(Spring)와 프론트(Vite), ai-server 가 모두 이 루트 .env 를 읽습니다.
# =====================================================================

# ----- 포트 -----
SERVER_PORT=8081
FRONTEND_PORT=5174
AI_SERVER_PORT=8000

# ----- DB -----
# 기본값: H2 파일 DB (MySQL 호환 모드) — 별도 설치 없이 바로 실행
DB_URL=jdbc:h2:file:./data/pixely;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
# 개발용 H2 웹 콘솔 (http://localhost:8081/h2-console, 로컬 접속만 허용). MySQL 사용 시·운영에서는 false
H2_CONSOLE_ENABLED=true
# MySQL 로 전환할 때 (로컬 MySQL 3306 또는 docker-compose 3307):
# DB_URL=jdbc:mysql://localhost:3306/pixely?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=pixely
# DB_PASSWORD=change-me

# docker-compose MySQL 용 (로컬 MySQL 이 3306 을 쓰고 있으면 3307 로 매핑)
MYSQL_PORT=3307
MYSQL_DATABASE=pixely
MYSQL_USER=pixely
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ----- 인증 -----
# 최소 32바이트 이상의 랜덤 문자열 (Base64 권장)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440
ADMIN_EMAIL=admin@pixely.com
ADMIN_PASSWORD=change-me

# ----- CORS / URL -----
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PUBLIC_BASE_URL=http://localhost:5174

# ----- 파일 저장 -----
UPLOAD_DIR=./uploads

# ----- AI -----
# mock | openai | fastapi
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=60
GENERATION_RATE_LIMIT_PER_MINUTE=5
MOCK_DELAY_MIN_MS=2000
MOCK_DELAY_MAX_MS=4000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1
FASTAPI_URL=http://localhost:8000
